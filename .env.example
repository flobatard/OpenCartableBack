# Secrets et overrides locaux UNIQUEMENT.
# La config publique (CORS, hôtes, OIDC, ...) vit dans config/<APP_ENV>.yaml.
# Priorité : variables d'env > .env > config/<APP_ENV>.yaml.

# Environnement : development (défaut), preprod ou production
# — sélectionne config/<APP_ENV>.yaml (les trois fichiers existent).
APP_ENV=development

# SECRET — mot de passe Postgres (aussi lu par docker-compose pour le service db)
POSTGRES_PASSWORD=change-me

# Override optionnel : URL complète (ex. Postgres managé type Neon).
# Prend le pas sur les POSTGRES_* ; sslmode/channel_binding sont traduits pour asyncpg.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Overrides OIDC éventuels (sinon valeurs de config/<APP_ENV>.yaml)
# OIDC_ISSUER=https://votre-instance.zitadel.cloud
# OIDC_AUDIENCE=client-id-ou-project-id-de-l-api

# SECRETS S3 — clés d'accès au bucket (endpoint/bucket/région = config/*.yaml).
# En dev, ce sont les identifiants root du MinIO de docker-compose (lus aussi
# par le service minio pour l'interpolation compose) : garder cohérent.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# SECRET — clé API du fallback serveur du client IA (BYO token : optionnel,
# provider/modèle/base_url = config/<APP_ENV>.yaml).
# AI_API_KEY=

# SECRET — clé maître du chiffrement des clés API IA par utilisateur
# (app/core/crypto.py). 32 octets base64 urlsafe, à générer avec :
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# ⚠ La changer rend illisibles les clés déjà stockées (les utilisateurs
# devront ré-enregistrer leur clé). Vide = feature indisponible (503).
# AI_CREDENTIALS_MASTER_KEY=

# SECRETS Langfuse (observabilité LLM, opt-in — LANGFUSE_HOST = config/*.yaml)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
